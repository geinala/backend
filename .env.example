# Simulation App Solver - Environment Configuration

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RQ Job Queue Configuration
RQ_QUEUE=default
RQ_JOB_TIMEOUT=10m
RQ_RESULT_TTL=300

# Environment
ENVIRONMENT=development

# Docker Configuration (use in docker-compose)
# REDIS_HOST=redis       # For Docker services
# ENVIRONMENT=production # For production
