# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RQ Job Queue Configuration - Multiple Queues Support
RQ_QUEUE=default

# Heavy Processing Queue (CPU-intensive, long-running tasks)
RQ_HEAVY_QUEUE=heavy
RQ_HEAVY_JOB_TIMEOUT=30m
RQ_HEAVY_RESULT_TTL=3600
RQ_HEAVY_WORKERS=2        # Number of workers for heavy processing

# Light Processing Queue (Quick tasks, low resource)
RQ_LIGHT_QUEUE=light
RQ_LIGHT_JOB_TIMEOUT=5m
RQ_LIGHT_RESULT_TTL=300
RQ_LIGHT_WORKERS=4        # Number of workers for light processing

# RQ Scheduler
ENABLE_SIMULATION_ARRIVAL_CHECK_SCHEDULE=true
SIMULATION_ARRIVAL_CHECK_SCHEDULE_INTERVAL_SECONDS=60
SIMULATION_ARRIVAL_CHECK_SCHEDULE_QUEUE=light
SIMULATION_ENGINE_TICK_INTERVAL_SECONDS=10
TRAFFIC_CONGESTION_THRESHOLD_SECONDS=420
TRAFFIC_CONGESTION_STRICT_MODE=true
TRAFFIC_CONGESTION_MULTI_ACCEPT_MODE=true

# Default job timeout and result TTL for standard queue
RQ_JOB_TIMEOUT=10m
RQ_RESULT_TTL=300

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=Simulation App Solver
API_VERSION=1.0.0

# API Documentation Configuration
ENABLE_DOCS=true
ENABLE_REDOC=true
ENABLE_OPENAPI=true

# CORS Configuration
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=content-length,x-json-response
CORS_MAX_AGE=600

# Environment
ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_BACKUP_COUNT=5
LOG_MAX_BYTES=10485760
ENABLE_FILE_LOGGING=false  # Set to true to write logs to file (default: false = console-only during development)

# Clerk Configuration
CLERK_SECRET_KEY=your_clerk_secret_key

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

API_KEY=your_secure_api_key
ENABLE_API_KEY_VALIDATION=true

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=simulation-results

# TomTom Configuration
TOMTOM_MATRIX_API_KEY=your_tomtom_matrix_api_key
TOMTOM_ROUTING_API_KEY=your_tomtom_routing_api_key
TOMTOM_SEARCH_API_KEY=your_tomtom_search_api_key
TOMTOM_TRAFFIC_API_KEY=your_tomtom_traffic_api_key

# Docker Configuration (use in docker-compose)
# REDIS_HOST=redis           # For Docker services
# ENVIRONMENT=production      # For production
# LOG_LEVEL=WARNING           # For production
# ENABLE_FILE_LOGGING=true    # For production - enable file logging
